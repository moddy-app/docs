---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import { getAllArticles, getArticle, getArticleContent, getAuthor, getLabel } from '../../utils/content.ts';
import { fetchDiscordUser } from '../../utils/discord.ts';
import { marked } from 'marked';

export async function getStaticPaths() {
  const articles = await getAllArticles();
  return articles.map(a => ({ params: { id: a.id } }));
}

const { id } = Astro.params;
const meta = await getArticle(id!);
if (!meta) return Astro.redirect('/404');

const frMd = await getArticleContent(id!, 'fr');
const enMd = await getArticleContent(id!, 'en');
const frHtml = await marked(frMd);
const enHtml = await marked(enMd);

const authorsList = await Promise.all(
  meta.authors.map(async (authorId) => {
    const author = await getAuthor(authorId);
    if (!author) return null;
    const needsDiscord = author.avatarUrl === 'DISCORD' || author.avatarDecorationUrl === 'DISCORD' || author.bannerColor === 'DISCORD';
    let discord = null;
    if (needsDiscord && author.discordId) discord = await fetchDiscordUser(author.discordId);
    return {
      ...author,
      resolvedAvatarUrl: author.avatarUrl === 'DISCORD' ? (discord?.avatar_url ?? null) : author.avatarUrl,
      resolvedAvatarDecoration: author.avatarDecorationUrl === 'DISCORD' ? (discord?.avatar_decoration_data?.asset_url ?? null) : author.avatarDecorationUrl,
    };
  })
);
const authors = authorsList.filter(Boolean) as NonNullable<typeof authorsList[number]>[];

const labels = (await Promise.all(meta.labels.map(id => getLabel(id)))).filter(Boolean);

const themeColor = labels[0]?.color ?? '#5B7BFA';

const d = new Date(meta.createdAt);
const months = ['JAN','FEB','MAR','APR','MAY','JUN','JUL','AUG','SEP','OCT','NOV','DEC'];
const dateShort = `${months[d.getMonth()]} ${d.getDate()}, ${d.getFullYear()}`;

const titleFr = meta.title['fr'];
const titleEn = meta.title['en'] ?? titleFr;
const summaryFr = meta.summary['fr'];
const summaryEn = meta.summary['en'] ?? summaryFr;

const bannerUrl = meta.banner
  ? (meta.banner.startsWith('http') ? meta.banner : `/content/articles/${id}/assets/${meta.banner}`)
  : null;
---

<Base
  title={titleFr}
  description={summaryFr}
  themeColor={themeColor}
  lang="fr"
  ogImage={bannerUrl ?? undefined}
  noIndex={meta.referencing === 3}
>
  <Nav slot="nav" slug={id} />

  <div class="page-wrapper">

    <!-- Article banner -->
    <div class="banner-section">
      <div class="banner-card" style={`background-color: ${themeColor}`}>
        {bannerUrl && <img draggable="false" src={bannerUrl} fetchpriority="high" alt="" />}
        <div class="banner-gradient"></div>
      </div>
    </div>

    <!-- Title -->
    <div class="content-col title-block">
      <h1 data-lang="fr">{titleFr}</h1>
      <h1 data-lang="en" style="display:none">{titleEn}</h1>
    </div>

    <!-- Date + summary -->
    <div class="content-col meta-row">
      <span class="article-date">{dateShort}</span>
      <span class="article-summary" data-lang="fr">{summaryFr}</span>
      <span class="article-summary" data-lang="en" style="display:none">{summaryEn}</span>
    </div>

    <!-- Labels -->
    {labels.length > 0 && (
      <div class="content-col labels-row">
        {labels.map(label => label && (
          <a
            href={`/collections/${label.id}`}
            class="label-badge"
            style={`color: ${label.color};`}
          >
            {label.name}
          </a>
        ))}
      </div>
    )}

    <!-- Authors -->
    {authors.length > 0 && (
      <div class="content-col authors-row">
        <div class="authors-stack">
          {authors.map(author => (
            <a href={`/authors/${author.id}`} class="author-avatar-wrap" title={author.username}>
              <md-ripple></md-ripple>
              <div class="author-avatar-clip">
                {author.resolvedAvatarUrl
                  ? <img draggable="false" src={author.resolvedAvatarUrl} alt={`${author.username}'s avatar`} />
                  : <span class="author-fallback">{author.username.charAt(0).toUpperCase()}</span>
                }
              </div>
              {author.resolvedAvatarDecoration && (
                <img class="author-deco" src={author.resolvedAvatarDecoration} alt="" aria-hidden="true" />
              )}
            </a>
          ))}
        </div>
        {authors[0] && (
          <div class="author-info">
            <a href={`/authors/${authors[0].id}`} class="author-name">{authors[0].username}</a>
            {authors[0].role?.['fr'] && <span class="author-role">{authors[0].role['fr']}</span>}
          </div>
        )}
      </div>
    )}

    <!-- Article content -->
    <div class="content-col prose-block">
      <div class="prose" data-lang="fr" set:html={frHtml}></div>
      <div class="prose" data-lang="en" style="display:none" set:html={enHtml}></div>
    </div>
  </div>
</Base>

<style>
  .page-wrapper {
    --content-w: var(--page-max-width);
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    padding: 2em 0 0;
    gap: 0;
  }

  .content-col {
    max-width: var(--content-w);
    width: 100%;
    padding: 0 1.5em;
  }

  /* ── Banner ──────────────────────────────────────────────── */
  .banner-section {
    width: 100%;
    max-width: min(1400px, calc(100vw - 2em));
    padding: 0 1.5em;
  }

  .banner-card {
    width: 100%;
    height: clamp(280px, 35vw, 480px);
    border-radius: 32px;
    position: relative;
    overflow: hidden;
  }

  .banner-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
    display: block;
  }

  .banner-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(transparent 45%, color-mix(in srgb, var(--md-sys-color-background) 55%, transparent) 100%);
  }

  /* ── Title ───────────────────────────────────────────────── */
  .title-block {
    margin-top: 2.5em;
  }

  .title-block h1 {
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 800;
    line-height: 1.12;
    text-wrap: balance;
    color: var(--md-sys-color-on-background);
    letter-spacing: -.03em;
  }

  /* ── Date + summary ──────────────────────────────────────── */
  .meta-row {
    display: flex;
    flex-direction: row;
    gap: 1.5em;
    margin-top: 1.25em;
    align-items: baseline;
    flex-wrap: wrap;
  }

  @media (max-width: 640px) {
    .meta-row { flex-direction: column; gap: .5em; }
  }

  .article-date {
    font-weight: 600;
    font-size: .875rem;
    color: var(--md-sys-color-on-surface-variant);
    white-space: nowrap;
    letter-spacing: .03em;
  }

  .article-summary {
    font-size: 1rem;
    color: var(--md-sys-color-on-surface-variant);
    line-height: 1.65;
  }

  /* ── Labels ──────────────────────────────────────────────── */
  .labels-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 1.25em;
  }

  .label-badge {
    font-size: .8rem;
    font-weight: 600;
    border-radius: 9999px;
    border: 1.5px solid currentColor;
    background-color: color-mix(in srgb, currentColor 10%, transparent);
    padding: 4px 13px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    letter-spacing: .02em;
    transition: background-color .15s ease;
  }
  .label-badge:hover {
    text-decoration: none;
    background-color: color-mix(in srgb, currentColor 18%, transparent);
  }

  /* ── Authors ─────────────────────────────────────────────── */
  .authors-row {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 1.5em;
    margin-bottom: 2.5em;
  }

  .authors-stack {
    display: flex;
    flex-direction: row-reverse;
    padding-right: 22px;
  }

  /* Avatar wrapper — no overflow so decoration can bleed out */
  .author-avatar-wrap {
    position: relative;
    width: 44px;
    height: 44px;
    margin-right: -22px;
    flex-shrink: 0;
    display: block;
    text-decoration: none;
  }

  /* The circular clip for the avatar image */
  .author-avatar-clip {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 3px solid var(--md-sys-color-background);
    overflow: hidden;
    background: var(--md-sys-color-surface-container);
    position: relative;
    z-index: 1;
  }

  .author-avatar-clip img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .author-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: .85rem;
    color: var(--md-sys-color-on-primary-container);
    background: var(--md-sys-color-primary-container);
  }

  /* Decoration — outside the clip, overlays on top */
  .author-deco {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 140%;
    height: 140%;
    pointer-events: none;
    z-index: 2;
  }

  .author-info {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .author-name {
    font-weight: 600;
    font-size: 1rem;
    color: var(--md-sys-color-on-surface);
    text-decoration: none;
  }
  .author-name:hover { text-decoration: underline; }

  .author-role {
    font-size: .825rem;
    color: var(--md-sys-color-on-surface-variant);
  }

  /* ── Prose content ───────────────────────────────────────── */
  .prose-block {
    margin-bottom: 8em;
    margin-top: 0;
  }

  .prose {
    color: var(--md-sys-color-on-surface);
    line-height: 1.75;
    font-size: 1.05rem;
    word-wrap: break-word;
  }

  .prose :global(h1) { font-size: 2rem; font-weight: 800; margin: 2.5rem 0 1rem; letter-spacing: -.025em; }
  .prose :global(h2) {
    font-size: 1.5rem; font-weight: 700; margin: 3rem 0 1rem;
    padding-bottom: .6rem; border-bottom: 1px solid var(--md-sys-color-outline-variant);
    letter-spacing: -.015em;
  }
  .prose :global(h3) { font-size: 1.2rem; font-weight: 700; margin: 2.25rem 0 .75rem; }
  .prose :global(h4) { font-size: 1.05rem; font-weight: 600; margin: 1.75rem 0 .5rem; }
  .prose :global(p) { margin: 1.1rem 0; }
  .prose :global(a) { color: var(--md-sys-color-primary); text-decoration: underline; text-underline-offset: 3px; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.75rem; margin: 1rem 0; }
  .prose :global(li) { margin: .5rem 0; }
  .prose :global(blockquote) {
    border-left: 3px solid var(--md-sys-color-primary);
    padding: .9rem 1.25rem;
    margin: 1.75rem 0;
    background: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
    border-radius: 0 12px 12px 0;
  }
  .prose :global(code) {
    font-family: 'Google Sans Code', monospace;
    font-size: .875em;
    background: var(--md-sys-color-surface-container-highest);
    padding: .2em .45em;
    border-radius: 6px;
    color: var(--md-sys-color-primary);
  }
  .prose :global(pre) {
    background: var(--md-sys-color-surface-container-highest);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: 16px;
    padding: 1.5rem 1.75rem;
    overflow-x: auto;
    margin: 1.75rem 0;
  }
  .prose :global(pre code) { background: none; padding: 0; color: var(--md-sys-color-on-surface); border-radius: 0; }
  .prose :global(img) { max-width: 100%; border-radius: 16px; margin: 1.75rem 0; }
  .prose :global(hr) { border: none; border-top: 1px solid var(--md-sys-color-outline-variant); margin: 2.5rem 0; }
  .prose :global(table) { width: 100%; border-collapse: collapse; margin: 1.75rem 0; font-size: .95rem; }
  .prose :global(th) {
    background: var(--md-sys-color-surface-container);
    padding: .85rem 1.1rem;
    text-align: left;
    font-weight: 700;
    border-bottom: 2px solid var(--md-sys-color-outline-variant);
  }
  .prose :global(td) { padding: .85rem 1.1rem; border-bottom: 1px solid var(--md-sys-color-outline-variant); }
</style>
