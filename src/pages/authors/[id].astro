---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getAllAuthors, getAuthor, getArticlesByAuthor, getAllLabels } from '../../utils/content.ts';
import { fetchDiscordUser, accentColorToHex } from '../../utils/discord.ts';

export async function getStaticPaths() {
  const authors = await getAllAuthors();
  return authors.map(a => ({ params: { id: a.id } }));
}

const { id } = Astro.params;
const author = await getAuthor(id!);
if (!author) return Astro.redirect('/404');

const needsDiscord = author.avatarUrl === 'DISCORD' || author.avatarDecorationUrl === 'DISCORD' || author.bannerColor === 'DISCORD';
let discord = null;
if (needsDiscord && author.discordId) discord = await fetchDiscordUser(author.discordId);

const avatarUrl = author.avatarUrl === 'DISCORD' ? (discord?.avatar_url ?? null) : author.avatarUrl;
const avatarDecoration = author.avatarDecorationUrl === 'DISCORD' ? (discord?.avatar_decoration_data?.asset_url ?? null) : author.avatarDecorationUrl;
const bannerColor = author.bannerColor === 'DISCORD' ? accentColorToHex(discord?.accent_color ?? null) : author.bannerColor;
const themeColor = bannerColor ?? '#0046F8';

const allArticles = await getArticlesByAuthor(id!);
const publicArticles = allArticles.filter(a => a.referencing !== 3);

const allLabels = await getAllLabels();
const labelsMap = Object.fromEntries(allLabels.map(l => [l.id, l]));

const bioFr = author.bio?.['fr'] ?? '';
const roleFr = author.role?.['fr'] ?? '';
---

<Base title={author.username} description={bioFr} themeColor={themeColor} lang="fr">
  <Nav slot="nav" slug={id} />

  <div class="page-wrapper">

    <div class="content-col">

      <!-- Profile card -->
      <div class="profile-card">

        <!-- Banner -->
        <div
          class="profile-banner"
          style={`background: linear-gradient(140deg, color-mix(in srgb, ${themeColor} 80%, #000) 0%, ${themeColor} 60%, color-mix(in srgb, ${themeColor} 60%, #fff) 100%)`}
        ></div>

        <!-- Avatar overlapping banner bottom -->
        <div class="avatar-outer">
          <div class="avatar-circle">
            {avatarUrl
              ? <img draggable="false" src={avatarUrl} alt={author.username} />
              : <span class="avatar-fallback">{author.username.charAt(0).toUpperCase()}</span>
            }
          </div>
          {avatarDecoration && (
            <img class="avatar-deco" src={avatarDecoration} alt="" aria-hidden="true" />
          )}
        </div>

        <!-- Info below banner -->
        <div class="profile-info">
          <div class="profile-name-row">
            <div class="profile-text">
              <h1>{author.username}</h1>
              {roleFr && <p class="profile-role">{roleFr}</p>}
            </div>
            <div class="profile-links">
              {author.links?.map(link => (
                <md-filled-tonal-icon-button href={link.url} target="_blank" aria-label={link.name}>
                  <md-icon>{link.icon ?? 'link'}</md-icon>
                </md-filled-tonal-icon-button>
              ))}
            </div>
          </div>
          {bioFr && <p class="profile-bio">{bioFr}</p>}
        </div>

      </div>
    </div>

    <!-- Articles -->
    <div class="content-col">
      <div class="section-header">
        <md-icon aria-hidden="true">article</md-icon>
        <h2>Articles ({publicArticles.length})</h2>
      </div>

      {publicArticles.length > 0 ? (
        <div class="articles-grid">
          {publicArticles.map(article => (
            <ArticleCard
              article={article}
              labels={article.labels.map(id => labelsMap[id]).filter(Boolean)}
              lang="fr"
            />
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <md-icon style="font-size:56px;color:var(--md-sys-color-outline)">article</md-icon>
          <p>Aucun article publié.</p>
        </div>
      )}
    </div>

  </div>
</Base>

<style>
  .page-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    gap: 3em;
    padding: 3em 0 0;
  }

  .content-col {
    max-width: var(--page-max-width);
    width: 100%;
    padding: 0 2em;
  }

  /* ══ Profile card ══════════════════════════════════════════ */
  .profile-card {
    background: var(--md-sys-color-surface);
    border-radius: 24px;
    overflow: visible;
    box-shadow: 0 1px 4px rgba(0,0,0,.07), 0 4px 16px rgba(0,0,0,.04);
    position: relative;
  }

  /* ── Banner ──────────────────────────────────────────────── */
  .profile-banner {
    height: 180px;
    border-radius: 24px 24px 0 0;
  }

  /* ── Avatar ──────────────────────────────────────────────── */
  .avatar-outer {
    position: absolute;
    top: calc(180px - 50px); /* banner height - half avatar */
    left: 28px;
    width: 100px;
    height: 100px;
  }

  .avatar-circle {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: 5px solid var(--md-sys-color-background);
    overflow: hidden;
    background: var(--md-sys-color-surface-container);
    position: relative;
    z-index: 1;
  }

  .avatar-circle img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .avatar-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
    font-weight: 800;
    background: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
  }

  /* Decoration sits OUTSIDE avatar-circle (no overflow clip) */
  .avatar-deco {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 128%;
    height: 128%;
    pointer-events: none;
    z-index: 2;
  }

  /* ── Info section below banner ───────────────────────────── */
  .profile-info {
    /* top padding = avatar overlap below banner (50px) + gap */
    padding: calc(50px + 16px) 28px 28px calc(28px + 100px + 20px);
    border-radius: 0 0 24px 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .profile-name-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .profile-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .profile-text h1 {
    font-size: 1.9rem;
    font-weight: 800;
    color: var(--md-sys-color-on-surface);
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .profile-role {
    font-size: 1rem;
    font-weight: 600;
    color: var(--md-sys-color-primary);
  }

  .profile-links {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
  }

  .profile-bio {
    font-size: 1rem;
    color: var(--md-sys-color-on-surface-variant);
    line-height: 1.7;
    max-width: 580px;
  }

  /* ══ Articles ══════════════════════════════════════════════ */
  .section-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 1.5em;
  }

  .section-header md-icon {
    color: var(--md-sys-color-on-surface);
    font-size: 1.4rem;
    line-height: 1;
  }

  .section-header h2 {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--md-sys-color-on-surface);
    letter-spacing: -0.01em;
    line-height: 1;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(410px, 100%), 1fr));
    gap: 20px;
  }

  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    min-height: 240px;
    color: var(--md-sys-color-on-surface-variant);
    text-align: center;
    font-size: 1.05rem;
  }

  /* ── Responsive ──────────────────────────────────────────── */
  @media (max-width: 640px) {
    .profile-info {
      padding: calc(50px + 16px) 20px 20px 20px;
    }
    .avatar-outer { left: 20px; }
    .profile-text h1 { font-size: 1.5rem; }
  }
</style>
