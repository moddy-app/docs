---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getAllAuthors, getAuthor, getArticlesByAuthor, getAllLabels } from '../../utils/content.ts';
import { fetchDiscordUser, accentColorToHex } from '../../utils/discord.ts';

export async function getStaticPaths() {
  const authors = await getAllAuthors();
  return authors.map(a => ({ params: { id: a.id } }));
}

const { id } = Astro.params;
const author = await getAuthor(id!);
if (!author) return Astro.redirect('/404');

const needsDiscord = author.avatarUrl === 'DISCORD' || author.avatarDecorationUrl === 'DISCORD' || author.bannerColor === 'DISCORD';
let discord = null;
if (needsDiscord && author.discordId) discord = await fetchDiscordUser(author.discordId);

const avatarUrl = author.avatarUrl === 'DISCORD' ? (discord?.avatar_url ?? null) : author.avatarUrl;
const avatarDecoration = author.avatarDecorationUrl === 'DISCORD' ? (discord?.avatar_decoration_data?.asset_url ?? null) : author.avatarDecorationUrl;
const bannerColor = author.bannerColor === 'DISCORD' ? accentColorToHex(discord?.accent_color ?? null) : author.bannerColor;
const themeColor = bannerColor ?? '#5B7BFA';

const allArticles = await getArticlesByAuthor(id!);
const publicArticles = allArticles.filter(a => a.referencing !== 3);

const allLabels = await getAllLabels();
const labelsMap = Object.fromEntries(allLabels.map(l => [l.id, l]));

const bioFr = author.bio?.['fr'] ?? '';
const roleFr = author.role?.['fr'] ?? '';
---

<Base title={author.username} description={bioFr} themeColor={themeColor} lang="fr">
  <Nav slot="nav" slug={id} />

  <div class="page-wrapper">

    <!-- Author header card -->
    <div class="content-col">
      <div class="author-header">
        <!-- Banner -->
        <div class="author-banner" style={`background: linear-gradient(135deg, color-mix(in srgb, ${themeColor} 40%, var(--md-sys-color-surface-container)) 0%, color-mix(in srgb, ${themeColor} 20%, var(--md-sys-color-surface-container)) 100%)`}>
          <h1 class="author-username">{author.username}</h1>
        </div>

        <!-- Avatar — positioned overlapping the banner bottom -->
        <div class="avatar-outer">
          <!-- Circular clip for avatar image -->
          <div class="avatar-circle">
            {avatarUrl
              ? <img draggable="false" src={avatarUrl} alt={author.username} />
              : <span class="avatar-fallback">{author.username.charAt(0).toUpperCase()}</span>
            }
          </div>
          <!-- Decoration overlaps outside the circle — NOT clipped -->
          {avatarDecoration && (
            <img class="avatar-deco" src={avatarDecoration} alt="" aria-hidden="true" />
          )}
        </div>
      </div>

      <!-- Action links (right of avatar area) -->
      <div class="author-actions">
        {author.links?.map(link => (
          <md-filled-tonal-icon-button href={link.url} target="_blank" aria-label={link.name}>
            <md-icon>{link.icon ?? 'link'}</md-icon>
          </md-filled-tonal-icon-button>
        ))}
      </div>

      <!-- Bio + role -->
      {(roleFr || bioFr) && (
        <div class="author-bio-section">
          {roleFr && <p class="author-role">{roleFr}</p>}
          {bioFr && <p class="author-bio">{bioFr}</p>}
        </div>
      )}
    </div>

    <!-- Articles grid -->
    <div class="content-col articles-section">
      <div class="section-header">
        <md-icon aria-hidden="true">article</md-icon>
        <h2>Articles ({publicArticles.length})</h2>
      </div>

      {publicArticles.length > 0 ? (
        <div class="articles-grid">
          {publicArticles.map(article => (
            <ArticleCard
              article={article}
              labels={article.labels.map(id => labelsMap[id]).filter(Boolean)}
              lang="fr"
            />
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <md-icon style="font-size:56px;color:var(--md-sys-color-outline)">article</md-icon>
          <p>Aucun article publié.</p>
        </div>
      )}
    </div>
  </div>
</Base>

<style>
  .page-wrapper {
    --content-w: var(--page-max-width);
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    gap: 4em;
    padding: 2em 0 0;
  }

  .content-col {
    max-width: var(--content-w);
    width: 100%;
    padding: 0 1.5em;
  }

  /* ── Author header ───────────────────────────────────────── */
  .author-header {
    position: relative;
    margin-bottom: calc(1.5em + 80px);
  }

  .author-banner {
    border-radius: 32px;
    width: 100%;
    height: 240px;
    display: flex;
    align-items: flex-end;
    padding: 1.5em 1.5em 1.5em calc(3em + 160px);
  }

  .author-username {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--md-sys-color-on-surface);
    word-break: break-word;
    line-height: 1.1;
  }

  /* Avatar outer — NO overflow:hidden so decoration bleeds out */
  .avatar-outer {
    position: absolute;
    bottom: -80px;
    left: 2.5em;
    width: 160px;
    height: 160px;
  }

  /* The visual circle for background + avatar clip */
  .avatar-circle {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: 6px solid var(--md-sys-color-background);
    overflow: hidden;
    background: var(--md-sys-color-surface-container-high);
    position: relative;
    z-index: 1;
  }

  .avatar-circle img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .avatar-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3.5rem;
    font-weight: 800;
    background: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
  }

  /* Decoration — positioned relative to .avatar-outer (no overflow:hidden) */
  .avatar-deco {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 125%;
    height: 125%;
    pointer-events: none;
    z-index: 2;
  }

  /* ── Action links ────────────────────────────────────────── */
  .author-actions {
    display: flex;
    flex-direction: row;
    gap: 10px;
    padding-left: calc(2.5em + 160px + 1em);
    margin-top: calc(-80px + 1em);
    margin-bottom: calc(80px - 1em);
  }

  /* ── Bio section ─────────────────────────────────────────── */
  .author-bio-section {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 1.25em;
  }

  .author-role {
    font-size: 1rem;
    font-weight: 600;
    color: var(--md-sys-color-primary);
  }

  .author-bio {
    font-size: .975rem;
    color: var(--md-sys-color-on-surface-variant);
    line-height: 1.7;
    max-width: 600px;
  }

  /* ── Articles section ────────────────────────────────────── */
  .articles-section {
    padding-top: 0;
  }

  .section-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 1.5em;
  }

  .section-header md-icon {
    color: var(--md-sys-color-primary);
    font-size: 22px;
  }

  .section-header h2 {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--md-sys-color-on-surface);
    letter-spacing: -0.01em;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr));
    gap: 1.25em;
  }

  /* ── Empty state ─────────────────────────────────────────── */
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    min-height: 240px;
    color: var(--md-sys-color-on-surface-variant);
    text-align: center;
    font-size: 1rem;
  }

  /* ── Responsive ──────────────────────────────────────────── */
  @media (max-width: 700px) {
    .author-banner {
      padding: 1.5em;
      align-items: flex-end;
      justify-content: flex-end;
      height: 180px;
    }
    .author-username { font-size: 1.75rem; }
    .avatar-outer {
      left: 50%;
      transform: translateX(-50%);
      bottom: -70px;
      width: 140px;
      height: 140px;
    }
    .author-header { margin-bottom: calc(1.5em + 70px); }
    .author-actions { padding-left: 0; justify-content: center; margin-top: calc(-70px + 1em); margin-bottom: calc(70px - 1em); }
  }
</style>
