---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getAllArticles, getAllLabels } from '../utils/content.ts';

const allArticles = await getAllArticles();
const publicArticles = allArticles.filter(a => a.referencing === 1);

const allLabels = await getAllLabels();
const labelsMap = Object.fromEntries(allLabels.map(l => [l.id, l]));
---

<Base title="Accueil" lang="fr" themeColor="#4A5FD5">
  <Nav slot="nav" slug="home" />

  <div class="page-wrapper">

    <!-- Hero banner -->
    <div class="hero-section">
      <div class="hero-card">
        <div class="hero-content">
          <svg class="hero-logo" viewBox="0 0 190 190" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M142.39 0H94.9335L47.4565 47.4564H0V94.9129H94.9335L142.39 47.4564V0Z" fill="white"/>
            <path d="M94.9335 94.9129L47.4568 142.39V189.846H94.9339L142.39 142.39H189.847V94.9128L94.9335 94.9129Z" fill="white"/>
          </svg>
          <div class="hero-text">
            <h1>Moddy Docs</h1>
            <p>Documentation officielle de Moddy, le bot Discord conçu pour votre communauté. Retrouvez ici toutes les informations pour bien démarrer et tirer le meilleur parti de Moddy.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Recent articles -->
    <div class="content-section">
      <div class="section-header">
        <md-icon aria-hidden="true">history</md-icon>
        <h2>Articles récents</h2>
        <md-text-button trailing-icon href="/articles" style="margin-left:auto">
          <md-icon slot="icon">arrow_forward</md-icon>
          Voir tout
        </md-text-button>
      </div>

      {publicArticles.length > 0 ? (
        <div class="articles-grid">
          {publicArticles.slice(0, 9).map(article => (
            <ArticleCard
              article={article}
              labels={article.labels.map(id => labelsMap[id]).filter(Boolean)}
              lang="fr"
            />
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <md-icon style="font-size:56px;color:var(--md-sys-color-outline)">article</md-icon>
          <p>Aucun article pour le moment.</p>
        </div>
      )}
    </div>
  </div>
</Base>

<style>
  .page-wrapper {
    --content-w: var(--page-max-width);
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    gap: 4em;
    padding: 2em 0 0;
  }

  /* ── Hero ────────────────────────────────────────────────── */
  .hero-section {
    width: 100%;
    max-width: var(--content-w);
    padding: 0 1.5em;
  }

  .hero-card {
    width: 100%;
    min-height: 280px;
    background: linear-gradient(135deg, var(--md-sys-color-primary) 0%, color-mix(in srgb, var(--md-sys-color-primary) 70%, #0046F8) 100%);
    border-radius: 32px;
    display: flex;
    align-items: flex-end;
    padding: 3em;
    position: relative;
    overflow: hidden;
  }

  .hero-card::before {
    content: '';
    position: absolute;
    top: -40px;
    right: -40px;
    width: 300px;
    height: 300px;
    background: rgba(255,255,255,0.06);
    border-radius: 50%;
  }

  .hero-card::after {
    content: '';
    position: absolute;
    bottom: -60px;
    right: 120px;
    width: 200px;
    height: 200px;
    background: rgba(255,255,255,0.04);
    border-radius: 50%;
  }

  .hero-content {
    display: flex;
    align-items: flex-end;
    gap: 2em;
    position: relative;
    z-index: 1;
  }

  .hero-logo {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    opacity: 0.9;
  }

  .hero-text h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: 0.4em;
  }

  .hero-text p {
    font-size: 1rem;
    color: rgba(255,255,255,0.8);
    line-height: 1.65;
    max-width: 560px;
  }

  @media (max-width: 600px) {
    .hero-card { padding: 2em; min-height: 220px; }
    .hero-content { flex-direction: column; align-items: flex-start; gap: 1em; }
    .hero-logo { width: 48px; height: 48px; }
  }

  /* ── Content section ─────────────────────────────────────── */
  .content-section {
    width: 100%;
    max-width: var(--content-w);
    padding: 0 1.5em;
  }

  /* ── Section header ──────────────────────────────────────── */
  .section-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 1.5em;
  }

  .section-header md-icon {
    color: var(--md-sys-color-primary);
    font-size: 22px;
  }

  .section-header h2 {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--md-sys-color-on-surface);
    letter-spacing: -0.01em;
  }

  /* ── Articles grid ───────────────────────────────────────── */
  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr));
    gap: 1.25em;
  }

  /* ── Empty state ─────────────────────────────────────────── */
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    min-height: 240px;
    color: var(--md-sys-color-on-surface-variant);
    text-align: center;
    font-size: 1rem;
  }
</style>
