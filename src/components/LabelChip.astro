---
import type { LabelMeta } from '../utils/content.ts';

interface Props {
  label: LabelMeta;
  href?: boolean;
}

const { label, href = true } = Astro.props;
const tag = href ? 'a' : 'span';
---

{href ? (
  <a class="label-chip" href={`/collections/${label.id}`} style={`--lc: ${label.color}`}>
    <span class="label-dot" style={`background:${label.color}`}></span>
    {label.name}
  </a>
) : (
  <span class="label-chip" style={`--lc: ${label.color}`}>
    <span class="label-dot" style={`background:${label.color}`}></span>
    {label.name}
  </span>
)}

<style>
  /* border-radius 8px comme dans la maquette (pas pill) */
  .label-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 11px;
    border-radius: 8px;
    font-size: .875rem;
    font-weight: 500;
    line-height: 1.25rem;
    text-decoration: none;
    background: color-mix(in srgb, var(--lc, var(--md-sys-color-primary)) 15%, var(--md-sys-color-surface-container-highest));
    color: var(--lc, var(--md-sys-color-primary));
    transition: background .15s, transform .1s;
    cursor: pointer;
    user-select: none;
    position: relative;
  }
  a.label-chip:hover {
    background: color-mix(in srgb, var(--lc, var(--md-sys-color-primary)) 20%, transparent);
    transform: translateY(-1px);
    text-decoration: none;
  }
  .label-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }
</style>
