---
import type { ArticleMeta, LabelMeta } from '../utils/content.ts';
import type { Lang } from '../i18n/translations.ts';

interface Props {
  article: ArticleMeta;
  labels?: LabelMeta[];
  lang: Lang;
}

const { article, labels = [], lang } = Astro.props;

const title = article.title[lang] ?? article.title['fr'];
const summary = article.summary[lang] ?? article.summary['fr'];

const d = new Date(article.createdAt);
const months = ['JAN','FEB','MAR','APR','MAY','JUN','JUL','AUG','SEP','OCT','NOV','DEC'];
const dateShort = `${months[d.getMonth()]} ${d.getDate()}`;

const primaryLabel = labels[0];
const bannerSrc = article.banner
  ? `/content/articles/${article.id}/assets/${article.banner}`
  : null;
---

<div class="card">
  <a href={`/articles/${article.id}`} class="card-banner" tabindex="-1" aria-hidden="true">
    {bannerSrc
      ? <img draggable="false" src={bannerSrc} alt="" loading="lazy" />
      : null
    }
  </a>
  <div class="card-body">
    <div class="card-meta">
      <span class="card-date">{dateShort}</span>
      {primaryLabel && (
        <a
          href={`/collections/${primaryLabel.id}`}
          class="label-badge"
          style={`color: ${primaryLabel.color};`}
        >
          <md-ripple></md-ripple>
          {primaryLabel.name}
        </a>
      )}
    </div>
    <a href={`/articles/${article.id}`} class="card-title-link">
      <h2>{title}</h2>
    </a>
    <p class="card-summary">{summary}</p>
    <div class="card-footer">
      <md-text-button trailing-icon href={`/articles/${article.id}`}>
        <md-icon slot="icon">arrow_forward</md-icon>
        Lire l'article
      </md-text-button>
    </div>
  </div>
</div>

<style>
  .card {
    background-color: var(--md-sys-color-surface-container);
    border-radius: 24px;
    flex-direction: column;
    width: 100%;
    height: 100%;
    display: flex;
    overflow: hidden;
    transition: box-shadow .2s ease;
  }

  .card:hover {
    box-shadow: 0 4px 24px color-mix(in srgb, var(--md-sys-color-on-surface) 8%, transparent);
  }

  .card-banner {
    user-select: none;
    background-color: var(--md-sys-color-surface-container-high);
    width: 100%;
    min-height: 200px;
    position: relative;
    overflow: hidden;
    display: block;
  }

  .card-banner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
    display: block;
    transition: scale .35s cubic-bezier(.2,.29,.27,1.55);
    scale: 1.01;
    position: absolute;
    inset: 0;
  }

  .card-banner::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(transparent 40%, color-mix(in srgb, var(--md-sys-color-surface-container) 55%, transparent) 100%);
    pointer-events: none;
  }

  .card:hover .card-banner img { scale: 1.05; }

  .card-body {
    flex-direction: column;
    height: 100%;
    padding: 1.5em;
    display: flex;
    gap: 8px;
  }

  /* ── Meta row (date + badge) ─────────────────────────────── */
  .card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 4px;
  }

  .card-date {
    font-weight: 600;
    font-size: .8rem;
    color: var(--md-sys-color-on-surface-variant);
    letter-spacing: .04em;
  }

  /* ── Label badge — outlined + full radius ────────────────── */
  .label-badge {
    font-size: .75rem;
    font-weight: 600;
    border-radius: 9999px;
    border: 1.5px solid currentColor;
    background-color: color-mix(in srgb, currentColor 10%, transparent);
    padding: 3px 10px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    position: relative;
    overflow: hidden;
    letter-spacing: .02em;
    white-space: nowrap;
    transition: background-color .15s ease;
  }
  .label-badge:hover {
    text-decoration: none;
    background-color: color-mix(in srgb, currentColor 18%, transparent);
  }

  /* ── Title ───────────────────────────────────────────────── */
  .card-title-link {
    text-decoration: none;
    color: var(--md-sys-color-on-surface);
  }
  .card-title-link:hover h2 { text-decoration: underline; }

  .card-title-link h2 {
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--md-sys-color-on-surface);
    letter-spacing: -0.01em;
  }

  /* ── Summary ─────────────────────────────────────────────── */
  .card-summary {
    font-size: .9rem;
    color: var(--md-sys-color-on-surface-variant);
    line-height: 1.65;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── Footer ──────────────────────────────────────────────── */
  .card-footer {
    margin-top: auto;
    padding-top: .75em;
  }
</style>
