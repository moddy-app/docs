---
import type { AuthorMeta } from '../utils/content.ts';
import type { Lang } from '../i18n/translations.ts';

interface Props {
  author: AuthorMeta;
  lang: Lang;
  size?: 'sm' | 'md';
}

const { author, lang, size = 'md' } = Astro.props;
const role = author.role?.[lang] ?? author.role?.['fr'] ?? '';
---

<a href={`/authors/${author.id}`} class:list={['author-chip', `author-chip--${size}`]}>
  {author.avatarUrl && author.avatarUrl !== 'DISCORD'
    ? (
      <img
        class="chip-avatar"
        src={author.avatarUrl}
        alt={author.username}
        loading="lazy"
        data-discord-avatar={author.discordId || ''}
      />
    ) : (
      <span
        class="chip-avatar chip-avatar--fallback"
        data-discord-avatar={author.discordId || ''}
      >
        {author.username.charAt(0).toUpperCase()}
      </span>
    )
  }
  <span class="chip-info">
    <span class="chip-name">{author.username}</span>
    {size === 'md' && role && <span class="chip-role">{role}</span>}
  </span>
</a>

<style>
  .author-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 12px 4px 4px;
    border-radius: 9999px;
    background: var(--md-sys-color-surface-container-high);
    text-decoration: none;
    color: var(--md-sys-color-on-surface);
    transition: background .15s, transform .1s;
    border: 1px solid var(--md-sys-color-outline-variant);
  }
  .author-chip:hover {
    background: var(--md-sys-color-surface-container-highest);
    transform: translateY(-1px);
    text-decoration: none;
  }

  .chip-avatar {
    width: 28px; height: 28px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }
  .chip-avatar--fallback {
    background: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: .8rem;
    font-weight: 700;
  }

  .chip-info { display: flex; flex-direction: column; }
  .chip-name { font-size: .85rem; font-weight: 600; line-height: 1.2; }
  .chip-role { font-size: .72rem; color: var(--md-sys-color-on-surface-variant); line-height: 1.2; }

  /* Small variant */
  .author-chip--sm { padding: 2px 10px 2px 2px; }
  .author-chip--sm .chip-avatar { width: 22px; height: 22px; }
  .author-chip--sm .chip-name { font-size: .8rem; }
</style>
