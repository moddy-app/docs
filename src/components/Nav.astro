---
interface Props {
  slug?: string;
}

const { slug = 'home' } = Astro.props;
---

<nav class="nav-bar" id="site-nav">
  <div class="nav-logo">
    <a href="/" class="nav-logo-link">
      <svg width="24" height="24" viewBox="0 0 190 190" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M142.39 0H94.9335L47.4565 47.4564H0V94.9129H94.9335L142.39 47.4564V0Z" fill="currentColor"/>
        <path d="M94.9335 94.9129L47.4568 142.39V189.846H94.9339L142.39 142.39H189.847V94.9128L94.9335 94.9129Z" fill="currentColor"/>
      </svg>
      <span>Moddy Docs</span>
    </a>
  </div>
  <span class="nav-sep" aria-hidden="true">/</span>
  <span class="nav-slug">{slug}</span>
  <div class="nav-actions">
    <md-icon-button id="theme-toggle" aria-label="Toggle theme">
      <md-icon>dark_mode</md-icon>
    </md-icon-button>
  </div>
</nav>

<script>
  const btn = document.getElementById('theme-toggle') as HTMLElement;
  if (btn) {
    const updateIcon = () => {
      const theme = document.documentElement.getAttribute('data-theme') || 'light';
      const icon = btn.querySelector('md-icon') as HTMLElement;
      if (icon) icon.textContent = theme === 'dark' ? 'light_mode' : 'dark_mode';
    };
    updateIcon();
    btn.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-theme') || 'light';
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('moddy-theme', next);
      updateIcon();
    });
  }
</script>

<style>
  .nav-bar {
    box-sizing: border-box;
    background-color: var(--md-sys-color-surface);
    border-bottom: 1px solid var(--md-sys-color-outline-variant);
    z-index: 100;
    flex-direction: row;
    align-items: center;
    gap: 12px;
    width: 100%;
    height: 64px;
    padding: 0 2em;
    display: flex;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
  }

  .nav-logo-link {
    box-sizing: border-box;
    width: fit-content;
    color: var(--md-sys-color-primary);
    user-select: none;
    flex-direction: row;
    gap: 10px;
    text-decoration: none;
    display: flex;
    align-items: center;
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: -0.01em;
  }
  .nav-logo-link:hover { text-decoration: none; opacity: 0.85; }

  .nav-sep {
    user-select: none;
    color: var(--md-sys-color-outline-variant);
    font-size: 1.1rem;
    font-weight: 300;
  }

  .nav-slug {
    white-space: pre;
    text-overflow: ellipsis;
    font-weight: 500;
    overflow: hidden;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 1rem;
    max-width: 300px;
  }

  .nav-actions {
    margin-left: auto;
  }
</style>
